{
  "name": "clearance",
  "version": "0.1.0",
  "description": "A GitHub App for hierarchical ownership and scoped review clearance.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/timothyreynolds/clearance.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean:dist && tsc -p tsconfig.build.json",
    "clean:dist": "rm -rf dist",
    "dev": "tsx watch src/server.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@octokit/app": "^16.1.2",
    "@octokit/webhooks": "^14.2.0",
    "dotenv": "^17.4.2",
    "toml": "^4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.6",
    "oxlint": "^1.65.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
