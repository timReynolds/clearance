{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "node", "vitest", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": ["coverage/**", "dist/**", "node_modules/**"],
  "rules": {},
  "env": {
    "builtin": true,
    "node": true
  }
}
